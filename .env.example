# AI Provider Configuration
# Set one of these API keys:
GOOGLE_API_KEY=your-google-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Provider and model (optional - auto-detected from API key)
AI_PROVIDER=gemini
MODEL=gemini-2.0-flash

# Database (Supabase - use the "connection string" from Project Settings > Database)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Auth.js (run `npx auth secret` to generate AUTH_SECRET)
AUTH_SECRET=
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Email (Resend — for access request notifications and approval/denial emails)
RESEND_API_KEY=re_your-resend-api-key

# App URL (used in email links)
NEXTAUTH_URL=http://localhost:3000

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
